<?xml version='1.0' encoding='utf-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaPrincipal">
  <grid id="panel" binding="panel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
    <margin top="24" left="24" bottom="24" right="24" />
    <constraints>
      <xy x="20" y="20" width="520" height="320" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="titulo" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="SpeedFast — Gestión de pedidos y entregas" />
        </properties>
      </component>
      <component id="btnRepartidores" binding="btnRepartidores" class="javax.swing.JButton">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Gestionar repartidores" />
        </properties>
      </component>
      <component id="btnPedidos" binding="btnPedidos" class="javax.swing.JButton">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Gestionar pedidos" />
        </properties>
      </component>
      <component id="btnEntregas" binding="btnEntregas" class="javax.swing.JButton">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Gestionar entregas" />
        </properties>
      </component>
    </children>
  </grid>
</form>