<?xml version='1.0' encoding='utf-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaRepartidores">
  <grid id="panel" binding="panel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="20" left="20" bottom="20" right="20" />
    <constraints>
      <xy x="20" y="20" width="980" height="660" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="label0" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="ID automático" />
          <labelFor value="txtId" />
        </properties>
      </component>
      <component id="txtId" class="javax.swing.JTextField" binding="txtId">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <editable value="false" />
        </properties>
      </component>
      <component id="label1" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Nombre" />
          <labelFor value="txtNombre" />
        </properties>
      </component>
      <component id="txtNombre" class="javax.swing.JTextField" binding="txtNombre">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <grid id="acciones" layout-manager="FlowLayout" hgap="8" vgap="0" flow-align="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="btnCrear" binding="btnCrear" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Crear" />
            </properties>
          </component>
          <component id="btnActualizar" binding="btnActualizar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Actualizar" />
            </properties>
          </component>
          <component id="btnEliminar" binding="btnEliminar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Eliminar" />
            </properties>
          </component>
          <component id="btnLimpiar" binding="btnLimpiar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Limpiar" />
            </properties>
          </component>
          <component id="btnRefrescar" binding="btnRefrescar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Refrescar" />
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="scroll">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="tabla" binding="tabla" class="javax.swing.JTable">
            <constraints />
            <properties>
              <fillsViewportHeight value="true" />
              <rowHeight value="26" />
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>