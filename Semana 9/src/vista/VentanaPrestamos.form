<?xml version='1.0' encoding='utf-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaPrestamos">
  <grid id="panel" binding="panel" layout-manager="GridLayoutManager" row-count="9" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
    <margin top="22" left="22" bottom="22" right="22" />
    <constraints>
      <xy x="20" y="20" width="1100" height="730" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="label0" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="ID automático" />
          <labelFor value="txtId" />
        </properties>
      </component>
      <component id="txtId" binding="txtId" class="javax.swing.JTextField">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <editable value="false" />
          <columns value="25" />
        </properties>
      </component>
      <component id="label1" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Estudiante" />
          <labelFor value="cmbEstudiante" />
        </properties>
      </component>
      <component id="cmbEstudiante" binding="cmbEstudiante" class="javax.swing.JComboBox">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <component id="label2" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Libro" />
          <labelFor value="cmbLibro" />
        </properties>
      </component>
      <component id="cmbLibro" binding="cmbLibro" class="javax.swing.JComboBox">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <component id="label3" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Fecha del préstamo (yyyy-MM-dd)" />
          <labelFor value="txtFecha" />
        </properties>
      </component>
      <component id="txtFecha" binding="txtFecha" class="javax.swing.JTextField">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <columns value="25" />
        </properties>
      </component>
      <component id="label4" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Vencimiento (yyyy-MM-dd)" />
          <labelFor value="txtVencimiento" />
        </properties>
      </component>
      <component id="txtVencimiento" binding="txtVencimiento" class="javax.swing.JTextField">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <columns value="25" />
        </properties>
      </component>
      <component id="label5" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Estado" />
          <labelFor value="txtEstado" />
        </properties>
      </component>
      <component id="txtEstado" binding="txtEstado" class="javax.swing.JTextField">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <editable value="false" />
          <columns value="25" />
        </properties>
      </component>
      <component id="label6" class="javax.swing.JLabel">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Devolución real" />
          <labelFor value="txtReal" />
        </properties>
      </component>
      <component id="txtReal" binding="txtReal" class="javax.swing.JTextField">
        <constraints>
          <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <editable value="false" />
          <columns value="25" />
        </properties>
      </component>
      <grid id="acciones" layout-manager="FlowLayout" hgap="8" vgap="0" flow-align="0">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="btnCrear" binding="btnCrear" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Prestar" />
            </properties>
          </component>
          <component id="btnActualizar" binding="btnActualizar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Actualizar" />
            </properties>
          </component>
          <component id="btnEliminar" binding="btnEliminar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Eliminar / cancelar" />
            </properties>
          </component>
          <component id="btnLimpiar" binding="btnLimpiar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Limpiar" />
            </properties>
          </component>
          <component id="btnRefrescar" binding="btnRefrescar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Refrescar" />
            </properties>
          </component>
          <component id="btnDevolver" binding="btnDevolver" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Devolver" />
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="scroll">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="tabla" binding="tabla" class="javax.swing.JTable">
            <constraints />
            <properties>
              <rowHeight value="27" />
              <fillsViewportHeight value="true" />
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
