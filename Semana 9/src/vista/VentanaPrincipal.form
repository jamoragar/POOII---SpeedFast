<?xml version='1.0' encoding='utf-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaPrincipal">
  <grid id="panel" binding="panel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
    <margin top="22" left="22" bottom="22" right="22" />
    <constraints>
      <xy x="20" y="20" width="1100" height="730" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="label0" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Sesión activa" />
          <labelFor value="lblSesion" />
        </properties>
      </component>
      <component id="lblSesion" binding="lblSesion" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <grid id="acciones" layout-manager="FlowLayout" hgap="8" vgap="0" flow-align="0">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="btnLibros" binding="btnLibros" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Libros" />
            </properties>
          </component>
          <component id="btnEstudiantes" binding="btnEstudiantes" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Estudiantes" />
            </properties>
          </component>
          <component id="btnUsuarios" binding="btnUsuarios" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Usuarios" />
            </properties>
          </component>
          <component id="btnCategorias" binding="btnCategorias" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Categorías" />
            </properties>
          </component>
          <component id="btnPrestamos" binding="btnPrestamos" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Préstamos y devoluciones" />
            </properties>
          </component>
          <component id="btnReportes" binding="btnReportes" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Reportes / historial" />
            </properties>
          </component>
          <component id="btnCerrarSesion" binding="btnCerrarSesion" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Cerrar sesión" />
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
