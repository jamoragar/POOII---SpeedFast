<?xml version='1.0' encoding='utf-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaReportes">
  <grid id="panel" binding="panel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="10">
    <margin top="22" left="22" bottom="22" right="22" />
    <constraints>
      <xy x="20" y="20" width="1100" height="730" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="label0" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Reporte" />
          <labelFor value="cmbTipo" />
        </properties>
      </component>
      <component id="cmbTipo" binding="cmbTipo" class="javax.swing.JComboBox">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <component id="label1" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Estudiante (para historial)" />
          <labelFor value="cmbEstudiante" />
        </properties>
      </component>
      <component id="cmbEstudiante" binding="cmbEstudiante" class="javax.swing.JComboBox">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <grid id="acciones" layout-manager="FlowLayout" hgap="8" vgap="0" flow-align="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="btnConsultar" binding="btnConsultar" class="javax.swing.JButton">
            <constraints />
            <properties>
              <text value="Consultar / refrescar" />
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="scroll">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="8" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="tabla" binding="tabla" class="javax.swing.JTable">
            <constraints />
            <properties>
              <rowHeight value="27" />
              <fillsViewportHeight value="true" />
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
