<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaRepartidores">
  <grid id="repartidores" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
    <margin top="20" left="20" bottom="20" right="20" />
    <constraints>
      <xy x="20" y="20" width="700" height="440" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="lblNombre" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Nombre" />
          <labelFor value="txtNombre" />
        </properties>
      </component>
      <component id="txtNombre" class="javax.swing.JTextField" binding="txtNombre">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <columns value="25" />
        </properties>
      </component>
      <component id="btnGuardar" class="javax.swing.JButton" binding="btnGuardar">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Guardar" />
        </properties>
      </component>
      <component id="btnRefrescar" class="javax.swing.JButton" binding="btnRefrescar">
        <constraints>
          <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Refrescar" />
        </properties>
      </component>
      <scrollpane id="scroll">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <preferredSize width="640" height="280" />
        </properties>
        <border type="none" />
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tabla">
            <constraints />
            <properties>
              <fillsViewportHeight value="true" />
              <rowHeight value="28" />
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
