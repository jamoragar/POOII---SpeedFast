<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaListaPedidos">
  <grid id="listado" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12" binding="panelPrincipal">
    <margin top="20" left="20" bottom="20" right="20" />
    <constraints>
      <xy x="20" y="20" width="800" height="480" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="lblResumen" class="javax.swing.JLabel" binding="lblResumen">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="0 pedidos | 3 repartidores disponibles" />
        </properties>
      </component>
      <component id="btnRefrescar" class="javax.swing.JButton" binding="btnRefrescar">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Refrescar" />
        </properties>
      </component>
      <scrollpane id="scrollPedidos">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <preferredSize width="760" height="300" />
        </properties>
        <border type="none" />
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tabla">
            <constraints />
            <properties>
              <rowHeight value="28" />
              <fillsViewportHeight value="true" />
            </properties>
          </component>
        </children>
      </scrollpane>
      <component id="instruccion" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Selecciona un pedido pendiente para iniciar o uno en reparto para finalizar." />
        </properties>
      </component>
      <grid id="asignacion" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="lblRepartidor" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
            </constraints>
            <properties>
              <text value="Repartidor:" />
              <labelFor value="cmbRepartidor" />
            </properties>
          </component>
          <component id="cmbRepartidor" class="javax.swing.JComboBox" binding="cmbRepartidor">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
            </constraints>
            <properties />
          </component>
          <component id="btnIniciar" class="javax.swing.JButton" binding="btnIniciar">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
            </constraints>
            <properties>
              <text value="Iniciar entrega" />
              <enabled value="false" />
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
