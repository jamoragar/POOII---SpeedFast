<?xml version='1.0' encoding='utf-8'?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaRegistroPedido">
  <grid id="registro" layout-manager="GridLayoutManager" row-count="5" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12" binding="panelPrincipal">
    <margin top="20" left="20" bottom="20" right="20" />
    <constraints>
      <xy x="20" y="20" width="800" height="480" />
    </constraints>
    <properties />
    <border type="none" />
    <children>
      <component id="aviso" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Ingresa la dirección y el tipo. MySQL generará el ID." />
        </properties>
      </component>
      <component id="lbltxtId" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="ID del pedido" />
          <labelFor value="txtId" />
        </properties>
      </component>
      <component id="txtId" class="javax.swing.JTextField" binding="txtId">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <columns value="22" />
          <editable value="false" />
          <text value="Automático (MySQL)" />
        </properties>
      </component>
      <component id="lbltxtDireccion" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Dirección de entrega" />
          <labelFor value="txtDireccion" />
        </properties>
      </component>
      <component id="txtDireccion" class="javax.swing.JTextField" binding="txtDireccion">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <columns value="22" />
        </properties>
      </component>
      <component id="lblcmbTipo" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties>
          <text value="Tipo de pedido" />
          <labelFor value="cmbTipo" />
        </properties>
      </component>
      <component id="cmbTipo" class="javax.swing.JComboBox" binding="cmbTipo">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
      </component>
      <grid id="botones" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="12" vgap="12">
        <margin top="0" left="0" bottom="0" right="0" />
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
        </constraints>
        <properties />
        <border type="none" />
        <children>
          <component id="btnLimpiar" class="javax.swing.JButton" binding="btnLimpiar">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
            </constraints>
            <properties>
              <text value="Limpiar" />
            </properties>
          </component>
          <component id="btnGuardar" class="javax.swing.JButton" binding="btnGuardar">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="1" indent="0" use-parent-layout="false" />
            </constraints>
            <properties>
              <text value="Guardar" />
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>